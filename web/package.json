{
  "name": "boblox-web",
  "version": "0.1.0",
  "private": true,
  "description": "Browser (WebAssembly) build of the Boblox Roblox-flavored Luau engine, with a playground",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "./build.sh wasm",
    "build:native": "./build.sh native",
    "goldens": "node tools/gen-goldens.mjs",
    "goldens:check": "node tools/gen-goldens.mjs --check",
    "test": "node --test test/*.test.mjs",
    "serve": "node tools/serve.mjs",
    "test:browser": "node --test test/browser/*.test.mjs"
  },
  "devDependencies": {
    "playwright": "^1.56.0"
  }
}
